# Dependencies
node_modules/

# Editor files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Cache
.eslintcache

# Package files
*.tgz

# Temporary build files
*.tmp.js

# Local test artifacts - screenshots, probe pages, runner output.
# Never commit these; agents and manual debugging drop them here.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
**/_probe.html
**/_scratch*
test-results/
playwright-report/
.playwright-mcp/

# Sourcemaps - only `npm run dev` writes them, and only into demo/dist.
# dist/ never gets any; the dist rule is a guard.
dist/*.map
demo/dist/*.map

# Claude Code local settings and agent worktrees
.claude/
