{
	"name": "@magic-spells/dropdown-panel",
	"version": "2.1.0",
	"description": "Accessible dropdown, popover and mega menu web component.",
	"author": "Cory Schulz",
	"license": "MIT",
	"type": "module",
	"main": "dist/dropdown-panel.cjs.js",
	"module": "dist/dropdown-panel.esm.js",
	"unpkg": "dist/dropdown-panel.min.js",
	"style": "dist/dropdown-panel.min.css",
	"exports": {
		".": {
			"types": "./dropdown-panel.d.ts",
			"import": "./dist/dropdown-panel.esm.js",
			"require": "./dist/dropdown-panel.cjs.js",
			"default": "./dist/dropdown-panel.esm.js"
		},
		"./css": "./dist/dropdown-panel.css",
		"./css/min": "./dist/dropdown-panel.min.css",
		"./css/src": "./dist/dropdown-panel.src.css",
		"./css/effects": "./dist/dropdown-panel.effects.css",
		"./css/effects/min": "./dist/dropdown-panel.effects.min.css",
		"./package.json": "./package.json"
	},
	"sideEffects": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/magic-spells/dropdown-panel"
	},
	"homepage": "https://github.com/magic-spells/dropdown-panel#readme",
	"bugs": {
		"url": "https://github.com/magic-spells/dropdown-panel/issues"
	},
	"keywords": [
		"dropdown",
		"dropdown-menu",
		"popover",
		"mega-menu",
		"navigation",
		"nav-menu",
		"hover-menu",
		"web-components",
		"custom-elements",
		"accessibility",
		"a11y",
		"keyboard-navigation"
	],
	"types": "./dropdown-panel.d.ts",
	"files": [
		"dist/",
		"src/",
		"dropdown-panel.d.ts"
	],
	"scripts": {
		"build": "rollup -c",
		"lint": "eslint src/ rollup.config.js",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build",
		"serve": "rollup -c --watch",
		"dev": "rollup -c --watch"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"browserslist": [
		"last 2 versions",
		"not dead",
		"not ie <= 11"
	],
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@rollup/plugin-node-resolve": "^15.2.3",
		"@rollup/plugin-terser": "^0.4.4",
		"eslint": "^9.38.0",
		"globals": "^15.15.0",
		"prettier": "^3.3.3",
		"rollup": "^3.0.0",
		"rollup-plugin-copy": "^3.5.0",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-serve": "^1.1.1"
	}
}
